# Server
PORT=3001

# STT provider (only Deepgram is supported)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Database (local docker compose Postgres)
DATABASE_URL=postgresql://skribo:skribo@localhost:5433/skribo?schema=public
JWT_SECRET=change-me-dev-secret

# LLM (OpenRouter) — optional; without a key analysis is disabled (503)
OPENROUTER_API_KEY=
LLM_MODEL_DETAILED=anthropic/claude-sonnet-4.5
LLM_MODEL_LIVE=anthropic/claude-haiku-4.5
