{
  "manifest_version": 3,
  "name": "Skribo",
  "version": "0.1.0",
  "description": "Real-time transcription for video calls",
  "permissions": ["tabCapture", "activeTab", "offscreen", "alarms", "scripting"],
  "host_permissions": [
    "http://localhost:3001/*",
    "ws://localhost:3001/*",
    "https://app.skribo.ru/*",
    "https://api.skribo.ru/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Skribo"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pachca.com/*",
        "https://app.pachca.com/*"
      ],
      "js": ["src/content/platforms/pachca/audio/per-track/webrtc-tracks-main.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": ["src/content/platforms/meet/audio/per-track/webrtc-tracks-main.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://zoom.us/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://*.pachca.com/*",
        "https://app.pachca.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["src/content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://*.pachca.com/*",
        "https://app.pachca.com/*",
        "https://meet.google.com/*",
        "https://zoom.us/*",
        "https://*.zoom.us/*"
      ],
      "js": ["src/content/platform-research.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["processor.worklet.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
