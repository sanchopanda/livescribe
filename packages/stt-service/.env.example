WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_CPU_COMPUTE_TYPE=int8
WHISPER_MODEL_SIZE=medium
WHISPER_WINDOW_SECONDS=6.0
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_PATIENCE=1.2
WHISPER_TEMPERATURE=0.0
WHISPER_VAD_FILTER=true
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_FORCE_FINAL_SECONDS=2.0
WHISPER_FORCE_FINAL_WORDS=8
WHISPER_MIN_FINAL_INTERVAL_SECONDS=0.8

# Optional explicit DLL directories (Windows)
# CUDA_DLL_DIR=C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.6\bin
# CUDNN_DLL_DIR=C:\path\to\cudnn\bin

# Optional Vosk model paths
# VOSK_MODEL_RU=./models/vosk-model-ru-0.22
# VOSK_MODEL_EN=./models/vosk-model-en-us-0.22
